# Copy to deploy/.env for docker compose. NEVER commit the real .env.
#
# Postgres & Redis are provisioned as separate Coolify-managed services.
# Grab their connection details from Coolify and paste them here.

# Full Postgres connection string from the Coolify Postgres resource.
# Use the INTERNAL hostname (service name) so it stays on Coolify's network.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME?sslmode=disable

# Redis address (host:port) from the Coolify Redis resource.
REDIS_ADDR=HOST:6379

# Public origin(s) allowed by CORS. Set to your domain in production.
CORS_ORIGINS=*
